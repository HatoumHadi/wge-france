[\"products\\/01JX3KBP9RYXV3X9QQZNAZ0P43.png\",\"products\\/01JX3KBPA57WH8K10HBD57RV3Z.png\"], 1991, {\"ar\": \"40 × 60 سم\", \"en\": \"40 x 60 cm\", \"fr\": \"40 x 60 cm\"}, {\"fr\": \"MOZ\", \"ar\": \"MOZ\", \"en\": \"MOZ\"}, {\"fr\": \"HEIDELBERG\", \"ar\": \"هايدلبرغ\", \"en\": \"HEIDELBERG\"}, {\"ar\": \"حوالي 6 كيلو وات أثناء التشغيل\", \"en\": \"Approx. 6 kW during operation\", \"fr\": \"Env. 6 kW en fonctionnement\"}, 12000, {\"en\":null}, heidelberg-moz-612129, {\"ar\": \"حتى 10,000 ورقة في الساعة\", \"en\": \"Up to 10,000 sheets per hour\", \"fr\": \"Jusqu’à 10 000 feuilles par heure\"}, 1, {\"ar\": \"أوفست تغذية ورق\", \"en\": \"Sheet-fed offset\", \"fr\": \"Offset feuille\"}, 2025-06-06 21:46:40, ?), ({\"ar\": \"هايدلبرغ\", \"en\": \"HEIDELBERG\", \"fr\": \"HEIDELBERG\"}, 1, 1, {\"ar\": \"مستخدم\", \"en\": \"Used\", \"fr\": \"Utilisée\"}, {\"ar\": \"بدون اتصال رقمي\", \"en\": \"No digital connectivity\", \"fr\": \"Pas de connectivité numérique\"}, 2025-06-07 12:20:00, {\"fr\":\"La HEIDELBERG QM46, fabriquée en 1999, est une presse d'impression offset compacte à 2 couleurs connue sous le nom de Quickmaster. Elle est idéale pour les petits et moyens tirages avec une excellente qualité d'impression. Cette machine offre un changement rapide des plaques et un contrôle précis de la pression pour assurer des résultats nets. Sa conception compacte la rend adaptée aux ateliers disposant d'un espace limité, tout en conservant une productivité élevée.\",\"en\":\"The 1999 HEIDELBERG QM46 is a compact 2-color offset printing press known as Quickmaster. It is ideal for small to medium print runs with excellent print quality. This machine offers quick plate changes and precise pressure control to ensure sharp results. Its compact design makes it suitable for workshops with limited space while maintaining high productivity.\",\"ar\":\"هايدلبرغ QM46، المصنعة عام 1999، هي آلة طباعة أوفست مدمجة ذات لونين تعرف باسم Quickmaster. مثالية للطباعة بكميات صغيرة إلى متوسطة مع جودة طباعة ممتازة. توفر هذه الماكينة تغييرًا سريعًا للألواح وتحكمًا دقيقًا في الضغط لضمان نتائج واضحة. تصميمها المدمج يجعلها مناسبة للورش ذات المساحات المحدودة مع الحفاظ على إنتاجية عالية.\"}, 0, 4, [\"products\\/01JX3KPR3TJ21WPPZT6CGC8RM4.jpg\",\"products\\/01JX3KPR4G87DW54N33HZW79ZP.jpg\",\"products\\/01JX3KPR4R0AB7A6H7QDKBXAPE.jpg\"], 1999, {\"ar\": \"46 × 32 سم\", \"en\": \"46 x 32 cm\", \"fr\": \"46 x 32 cm\"}, {\"fr\": \"QM46\", \"ar\": \"QM46\", \"en\": \"QM46\"}, {\"fr\": \"HEIDELBERG\", \"ar\": \"هايدلبرغ\", \"en\": \"HEIDELBERG\"}, {\"ar\": \"حوالي 4.5 كيلو وات أثناء التشغيل\", \"en\": \"Approx. 4.5 kW during operation\", \"fr\": \"Env. 4,5 kW en fonctionnement\"}, 9500, {\"en\":null}, heidelberg-qm46-quickmaster, {\"ar\": \"حتى 7,000 ورقة في الساعة\", \"en\": \"Up to 7,000 sheets per hour\", \"fr\": \"Jusqu’à 7 000 feuilles par heure\"}, 1, {\"ar\": \"أوفست لونين\", \"en\": \"2-color offset\", \"fr\": \"Offset 2 couleurs\"}, 2025-06-06 21:52:43, ?), ({\"ar\": \"هايدلبرغ\", \"en\": \"HEIDELBERG\", \"fr\": \"HEIDELBERG\"}, 1, 1, {\"ar\": \"مستخدم\", \"en\": \"Used\", \"fr\": \"Utilisée\"}, {\"ar\": \"بدون اتصال رقمي\", \"en\": \"No digital connectivity\", \"fr\": \"Pas de connectivité numérique\"}, 2025-06-07 12:30:00, {\"fr\":\"La presse HEIDELBERG GTOZ de 1995, équipée NP, est une machine offset feuille polyvalente et fiable. Elle est idéale pour des tirages courts à moyens avec une qualité d'impression élevée. Équipée du système NP, elle offre une meilleure précision dans l'encrage et un contrôle optimisé des couleurs. Cette presse est appréciée pour sa robustesse et sa facilité d'utilisation, adaptée aux petits ateliers et aux imprimeries commerciales.\",\"en\":\"The 1995 HEIDELBERG GTOZ press, equipped with NP system, is a versatile and reliable sheet-fed offset machine. It is ideal for short to medium print runs with high print quality. Equipped with the NP system, it provides better ink distribution and optimized color control. This press is known for its durability and ease of use, suitable for small workshops and commercial print shops.\",\"ar\":\"آلة الطباعة هايدلبرغ GTOZ لعام 1995، المجهزة بنظام NP، هي آلة طباعة أوفست تغذية ورق متعددة الاستخدامات وموثوقة. مناسبة للطباعة بكميات صغيرة إلى متوسطة بجودة طباعة عالية. مع نظام NP، توفر توزيعًا أفضل للحبر وتحكمًا محسنًا في الألوان. هذه الآلة معروفة بمتانتها وسهولة استخدامها، ومناسبة للورش الصغيرة ومطابع الأعمال التجارية.\"}, 0, 5, [\"products\\/01JX3M04DKFN06TK1FM6RVGVAN.jpg\",\"products\\/01JX3M04E74YMB5JCY89XBPBQD.jpg\"], 1995, {\"ar\": \"36 × 52 سم\", \"en\": \"36 x 52 cm\", \"fr\": \"36 x 52 cm\"}, {\"fr\": \"GTOZ\", \"ar\": \"GTOZ\", \"en\": \"GTOZ\"}, {\"fr\": \"HEIDELBERG\", \"ar\": \"هايدلبرغ\", \"en\": \"HEIDELBERG\"}, {\"ar\": \"حوالي 5 كيلو وات أثناء التشغيل\", \"en\": \"Approx. 5 kW during operation\", \"fr\": \"Env. 5 kW en fonctionnement\"}, 11000, {\"en\":null}, heidelberg-gtoz-np, {\"ar\": \"حتى 9,000 ورقة في الساعة\", \"en\": \"Up to 9,000 sheets per hour\", \"fr\": \"Jusqu’à 9 000 feuilles par heure\"}, 1, {\"ar\": \"أوفست تغذية ورق\", \"en\": \"Sheet-fed offset\", \"fr\": \"Offset feuille\"}, 2025-06-06 21:57:50, ?), ({\"ar\": \"هايدلبرغ\", \"en\": \"HEIDELBERG\", \"fr\": \"HEIDELBERG\"}, 1, 0, {\"ar\": \"بحالة جيدة\", \"en\": \"Good condition\", \"fr\": \"Bon état\"}, {\"ar\": \"بدون اتصال رقمي\", \"en\": \"No digital connectivity\", \"fr\": \"Pas de connectivité numérique\"}, 2025-06-07 12:40:00, {\"fr\":\"La presse HEIDELBERG SORM, datant des années 1980 environ, est une machine offset robuste et fiable. En bon état, elle convient pour des tirages variés avec une qualité d'impression satisfaisante. Elle est particulièrement adaptée aux ateliers souhaitant une machine éprouvée, capable de gérer des travaux d'impression classiques avec efficacité.\",\"en\":\"The HEIDELBERG SORM press, from the approximate 1980s, is a robust and reliable offset printing machine. In good condition, it is suitable for various print runs with satisfactory print quality.